generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Genero {
  MASCULINO
  FEMININO
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

enum TipoUsuario {
  ADMIN
  MEMBRO
  LIDER
  CO_LIDER
  PASTOR
  TESOUREIRO
  CONTADOR
}

enum InscricaoStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

enum PosicaoEscala {
  ESTACIONAMENTO
  PORTA_PRINCIPAL
  PORTA_LATERAL
  DATASHOW
  TRANSMISSAO
  CANTINA
  MIDIAS_CAMERA
  MIDIAS_STORIES
}

model Usuario {
  id              String       @id @default(uuid())
  email           String       @unique
  senhaHash       String
  foto            String?
  nome            String
  sobrenome       String
  tipo            TipoUsuario  @default(MEMBRO)
  ativo           Boolean      @default(true)
  dataAniversario DateTime?
  genero          Genero?
  estadoCivil     EstadoCivil?
  logradouro      String?
  bairro          String?
  cidade          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  eventosCriados          Evento[]            @relation("EventoCriador")
  inscricoes              Inscricao[]
  ministeriosComoLider    Ministerio[]        @relation("MinisterioLider")
  ministeriosComoCoLider  MinisterioCoLider[]
  escalasGeradas          Escala[]            @relation("EscalaGerada")
  escalasAtribuidas       EscalaVaga[]        @relation("EscalaAtribuida")
}

model Ministerio {
  id        String              @id @default(uuid())
  nome      String
  descricao String?
  liderId   String?
  lider     Usuario?            @relation("MinisterioLider", fields: [liderId], references: [id])
  coLideres    MinisterioCoLider[]
  eventos      Evento[]
  escalasVagas EscalaVaga[]
  createdAt    DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model MinisterioCoLider {
  ministerioId String
  usuarioId    String
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])

  @@id([ministerioId, usuarioId])
}

model Evento {
  id           String      @id @default(uuid())
  foto         String?
  nome         String
  descricao    String
  dataHora     DateTime
  localizacao  String?
  valor        Float       @default(0)
  ministerioId String?
  criadorId    String
  ministerio   Ministerio? @relation(fields: [ministerioId], references: [id])
  criador      Usuario     @relation("EventoCriador", fields: [criadorId], references: [id])
  inscritos    Inscricao[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Inscricao {
  id          String          @id @default(uuid())
  usuarioId   String
  eventoId    String
  status      InscricaoStatus @default(PENDENTE)
  pagoEm      DateTime?
  comprovante String?
  usuario     Usuario         @relation(fields: [usuarioId], references: [id])
  evento      Evento          @relation(fields: [eventoId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([usuarioId, eventoId])
}

model Escala {
  id        String          @id @default(uuid())
  mes       Int
  ano       Int
  criadorId String
  criador   Usuario         @relation("EscalaGerada", fields: [criadorId], references: [id])
  domingos  EscalaDomingo[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([mes, ano])
}

model EscalaDomingo {
  id       String       @id @default(uuid())
  escalaId String
  escala   Escala       @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  data     DateTime
  vagas    EscalaVaga[]
}

model EscalaVaga {
  id           String        @id @default(uuid())
  domingoId    String
  domingo      EscalaDomingo @relation(fields: [domingoId], references: [id], onDelete: Cascade)
  posicao      PosicaoEscala
  slot         Int           @default(1)
  usuarioId    String?
  usuario      Usuario?      @relation("EscalaAtribuida", fields: [usuarioId], references: [id])
  ministerioId String?
  ministerio   Ministerio?   @relation(fields: [ministerioId], references: [id])
  grupoCaseiro String?
  createdAt    DateTime      @default(now())

  @@unique([domingoId, posicao, slot])
}
